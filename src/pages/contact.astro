---
import Base from "../layouts/Base.astro";
import { site, mailto, url } from "../data/site";

const contact = site.contact;
---

<Base title={`Contact — ${site.name.toUpperCase()}`} current="contact">
  <section class="page-head">
    <p class="page-eyebrow">Contact</p>
    <h1>{contact.heading}</h1>
    <p class="page-intro">{contact.text}</p>
  </section>

  <section class="contact-grid">
    <div class="contact-main reveal">
      <p class="contact-label">Write to the studio</p>
      <a class="contact-email" href={mailto(site.email)}>{site.email}</a>
      <p class="contact-note">
        A few sentences about the house and your timing is plenty to start.
      </p>
      <a class="closing-link" href={mailto(site.email)}>Send an enquiry</a>
    </div>
    <aside class="contact-aside reveal" aria-label="Good to know">
      <p class="contact-label">Good to know</p>
      <ul class="note-list">
        {contact.notes.map((n) => <li>{n}</li>)}
      </ul>
      <p class="contact-label">Studios</p>
      <p class="contact-note">{site.location}</p>
      <p class="contact-label">See the work first</p>
      <p class="contact-note">
        <a class="text-link" href={url("/gallery")}>Browse the gallery</a>
      </p>
    </aside>
  </section>
</Base>
