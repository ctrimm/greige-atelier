---
import Base from "../layouts/Base.astro";
import { site, projectRoutes, imgSrcset, url } from "../data/site";

export function getStaticPaths() {
  return projectRoutes();
}

const { project, next } = Astro.props;
---

<Base
  title={`${project.title.toUpperCase()} — ${site.name.toUpperCase()}`}
  current="project"
  description={project.summary}
>
  <section class="page-head">
    <p class="page-eyebrow">{project.category}</p>
    <h1>{project.title}</h1>
    <p class="page-intro">
      {project.location} · {project.year}
    </p>
  </section>

  <section class="project-layout">
    <div class="project-copy">
      <p>{project.summary}</p>
      <h2 class="section-label">Scope</h2>
      <ul class="chip-list">
        {project.scope.map((s) => <li>{s}</li>)}
      </ul>
      <a class="text-link" href={url("/contact")}>Commission a room like this</a>
    </div>
    <figure class="project-photo">
      <img
        src={url(project.image)}
        alt={project.imageAlt}
        width="944"
        height="624"
        fetchpriority="high"
        srcset={imgSrcset(project.image, [480, 960], 944)}
        sizes="(max-width: 760px) 92vw, 58vw"
      />
    </figure>
  </section>

  <nav class="project-next" aria-label="Next project">
    Next project — <a href={url(`/${next.slug}`)}>{next.title}</a>
  </nav>
</Base>
